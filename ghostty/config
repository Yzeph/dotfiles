# =================
# Ghostty 配置 —— 复刻自 Kitty 配置
# =================

# =================
# 字体配置
# =================
font-family = Monaspace Radon NF Wide Italic
font-family = LXGW WenKai Mono Light
font-size = 14
font-feature = calt

# =================
# 背景与透明度
# =================
background-opacity = 0.8
background-blur-radius = 30
background-image = /Users/zephyr/Pictures/IMG_4660.JPEG

# =================
# 窗口设置
# =================
window-padding-x = 15
window-padding-y = 15
macos-titlebar-style = hidden

# =================
# 光标设置
# =================
cursor-style = block

# =================
# 主题（注意：需要带空格）
# =================
theme = Catppuccin Mocha

# =================
# macOS 特定
# =================
macos-option-as-alt = true

# =================
# 剪贴板与选择
# =================
copy-on-select = clipboard

# =================
# 快捷键（复刻 Kitty 布局）
# =================

# cmd+d → 水平分割（左右分屏）
keybind = super+d=new_split:right

# cmd+r → 垂直分割（上下分屏）
keybind = super+r=new_split:down

# cmd+w → 关闭当前面板
keybind = super+w=close_surface

# cmd+, → 打开配置文件
keybind = super+,=open_config
